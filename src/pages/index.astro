---
/**
 * 首页。
 *
 * 首屏是已验收的方向 γ「百叶窗」（docs/requirements.md §5.5）。
 * 首屏之下不放「四行自我介绍」式列表——那种版式任何开发者主页都能用，
 * 用户已两次否决。这里只放可核对的事实：素材计数、笔记骨架的真实形状、
 * 以及每一个数字的出处。
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../config/site';
---

<Base overlayBar>
  <Hero />

  <section class="facts" aria-labelledby="facts-h">
    <h2 id="facts-h" class="sr-only">
      站点内容
    </h2>
    <dl class="counts">
      <div class="c reveal">
        <dt>笔记</dt>
        <dd>
          <span class="n">67</span> 篇
        </dd>
      </div>
      <div class="c reveal" style="--d:40ms">
        <dt>影像</dt>
        <dd>
          <span class="n">412</span> 张
        </dd>
      </div>
      <div class="c reveal" style="--d:80ms">
        <dt>整理跨度</dt>
        <dd>
          <span class="n">2024</span> 至 <span class="n">2026</span>
        </dd>
      </div>
      <div class="c reveal" style="--d:120ms">
        <dt>《教父》笔记</dt>
        <dd>
          <span class="n">827</span> 行
        </dd>
      </div>
    </dl>
  </section>

  <section class="shapes" aria-labelledby="shapes-h">
    <p class="kicker">四篇笔记的骨架</p>
    <h2 id="shapes-h">同样是笔记，结构不一样。</h2>

    <div class="grid">
      <article class="s reveal">
        <h3>论坛讨论</h3>
        <p class="sub">LangGraph 是不是方向不太对</p>
        <ol class="rows">
          <li>
            <span class="f">楼主</span>
            <span>数据分析 Agent 用 LangGraph 是不是过度设计</span>
          </li>
          <li>
            <span class="f">2 楼</span>
            <span>ReAct 加可靠工具链就够，状态机留给审计要求</span>
          </li>
          <li>
            <span class="f">11 楼</span>
            <span>我们线上用的是 Agent SDK，LangGraph 走不通</span>
          </li>
        </ol>
      </article>

      <article class="s reveal" style="--d:60ms">
        <h3>科普速查</h3>
        <p class="sub">AI 中转站大起底</p>
        <table class="tbl">
          <tbody>
            <tr>
              <th scope="row">是否公开倍率</th>
              <td class="ok">必须</td>
            </tr>
            <tr>
              <th scope="row">是否支持自查用量</th>
              <td class="ok">必须</td>
            </tr>
            <tr>
              <th scope="row">来源是逆向或黑渠道</th>
              <td class="no">避免</td>
            </tr>
          </tbody>
        </table>
      </article>

      <article class="s reveal" style="--d:120ms">
        <h3>技术长文</h3>
        <p class="sub">从 vibe coding 到 spec coding</p>
        <ol class="toc">
          <li>
            <span class="num">01</span>Prompt / Rules / Skill 的边界
          </li>
          <li>
            <span class="num">02</span>三个没被解决的问题
          </li>
          <li>
            <span class="num">03</span>Trellis 的八步机制
          </li>
        </ol>
      </article>
    </div>

    <p class="more">
      <a class="btn" href="/notes">
        全部笔记
        <svg
          viewBox="0 0 24 24"
          width="15"
          height="15"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </p>
  </section>

  <footer class="foot">
    <span>{SITE.title}</span>
    <span class="dot" aria-hidden="true"></span>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <span class="dot" aria-hidden="true"></span>
    <a href={SITE.github} rel="me noopener" target="_blank">
      GitHub
    </a>
  </footer>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: clip;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .facts {
    padding: clamp(72px, 12vh, 140px) clamp(20px, 6vw, 96px);
    border-bottom: 1px solid var(--rule);
  }

  .counts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }

  .counts .c dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
    margin-bottom: 12px;
  }

  .counts .c dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 46px);
    color: var(--fg);
  }

  .counts .n {
    color: var(--gold);
  }

  .shapes {
    padding: clamp(72px, 12vh, 140px) clamp(20px, 6vw, 96px);
  }

  /* 章节头纵向堆叠，不做「左大标题 + 右小说明」的分栏（Split-Header Ban） */
  .kicker {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
    margin: 0 0 20px;
  }

  .shapes h2 {
    font-size: clamp(28px, 4.4vw, 60px);
    max-width: 18ch;
    margin: 0 0 clamp(40px, 6vh, 72px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(28px, 4vw, 64px);
  }

  .s h3 {
    font-size: 20px;
    margin: 0 0 8px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .s .sub {
    color: var(--fg-faint);
    font-size: 13px;
    margin: 0 0 24px;
  }

  /* 长列表不用默认 ul + 分隔线，用带沟槽的表格式行 */
  .rows,
  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .rows li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 12px;
    font-size: 14px;
    color: var(--fg-dim);
  }

  .rows .f {
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 0.06em;
    padding-top: 2px;
  }

  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .tbl th,
  .tbl td {
    text-align: left;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    font-weight: 400;
  }

  .tbl th {
    color: var(--fg-dim);
  }

  .tbl td {
    text-align: right;
  }

  .tbl .ok {
    color: var(--fg);
  }

  .tbl .no {
    color: var(--gold);
  }

  .toc li {
    display: flex;
    gap: 12px;
    font-size: 14px;
    color: var(--fg-dim);
  }

  .toc .num {
    color: var(--fg-faint);
    font-size: 12px;
    letter-spacing: 0.06em;
    padding-top: 2px;
  }

  .more {
    margin: clamp(44px, 7vh, 80px) 0 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 11px 22px;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn:hover {
      border-color: var(--gold);
      color: var(--gold);
    }
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 34px clamp(20px, 6vw, 96px) 56px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--fg-faint);
  }

  .foot a {
    color: var(--fg-dim);
    transition: color var(--dur-dropdown) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .foot a:hover {
      color: var(--gold);
    }
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentcolor;
    opacity: 0.5;
  }
</style>

<script>
  /**
   * 元素入场。
   *
   * 优先用 @starting-style（纯 CSS，不需要 JS）；对不支持的浏览器用
   * IntersectionObserver 加类兜底。先给 <html> 加 .js-ready，保证在 JS
   * 完全不可用时内容仍然可见——不写 JS 就先隐藏内容是经典的可访问性事故。
   */
  const supportsStartingStyle = CSS.supports('transition-behavior', 'allow-discrete');
  document.documentElement.classList.add('js-ready');

  const targets = [...document.querySelectorAll<HTMLElement>('.reveal')];

  if (targets.length > 0) {
    if (supportsStartingStyle) {
      // 交给 CSS：加类只为触发一次 transition，不参与定位计算
      requestAnimationFrame(() => {
        targets.forEach((el) => el.classList.add('is-in'));
      });
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
      );
      targets.forEach((el) => observer.observe(el));
    }
  }
</script>
